# ------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored and must NEVER be committed.
# ------------------------------------------------------------

# PostgreSQL connection string.
# Local example:
#   postgres://postgres:postgres@localhost:5432/jamia
# Hosted examples (Neon / Supabase / Render):
#   postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jamia

# Set to "disable" for a LOCAL Postgres without SSL.
# Leave empty / unset for hosted providers (SSL is enabled by default).
PGSSL=disable

# Secret used to sign login tokens (JWT). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-this-to-a-long-random-secret

# Port the server listens on (hosts usually set this automatically).
PORT=5050

# Production browser origin(s), comma-separated if more than one.
FRONTEND_URL=http://localhost:5050
CORS_ORIGIN=http://localhost:5050
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata
PG_POOL_MAX=10

# Initial admin account used only by `npm run seed` / `npm run setup`.
# In production, set a unique email and a strong 10+ character password in the host dashboard.
SEED_ADMIN_EMAIL=admin@jamia.test
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=حضرت مولانا اسحاق گھارے صاحب
